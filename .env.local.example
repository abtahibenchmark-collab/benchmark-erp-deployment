# Google Apps Script deployed Web App URL (ends in /exec)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
# Copy the generated ERP_API_TOKEN from Apps Script execution logs. Server-only secret; never use NEXT_PUBLIC_ prefix.
ERP_API_TOKEN=PASTE_TOKEN_FROM_APPS_SCRIPT_SETUP_LOG

# Used to sign secure, HTTP-only ERP login session cookies. Generate a long random value.
ERP_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional: enable generative Abtahi's Brain. Provider charges may apply.
# Keep both values server-only; never use NEXT_PUBLIC_ prefixes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
